# Copy to frontend/.env and fill in. Vite only exposes VITE_-prefixed vars.

# Where the Python API is listening. Must include the /api/v1 prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Live alert socket. Not implemented server-side yet — the dashboard falls
# back to a simulated stream until the /ws/alerts route exists.
VITE_WS_URL=ws://127.0.0.1:8000/ws/alerts

# Must match IBVAP_API_TOKEN in the backend .env, or every request 401s.
# NOTE: this value is compiled into the browser bundle and is readable by
# anyone who can load the dashboard. Safe only on a trusted network.
VITE_API_TOKEN=
